{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(bump)"
  ],
  "timezone": "Europe/Paris",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "enabledManagers": [
    "ansible-galaxy",
    "argocd",
    "custom.regex",
    "dockerfile",
    "github-actions",
    "kubernetes",
    "kustomize",
    "npm",
    "terraform"
  ],
  "argocd": {
    "managerFilePatterns": ["/^apps/gitops/clusters/.+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/(argocd|bingops|cloudflare|platform|workloads)/.+\\.yaml$/",
      "/^capi/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Follow the published HomeOps workspace image while retaining its digest pin",
      "managerFilePatterns": ["/^apps/workloads/coder/base/template/main\\.tf$/"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>ghcr\\.io/bingops-com/homeops-dev)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "currentValueTemplate": "latest",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update tool versions declared in Dockerfile environment variables",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[a-z-]+))?\\s+(?:ENV|ARG) [A-Z0-9_]+=(?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update Elastic Stack versions declared in ECK resources",
      "managerFilePatterns": ["/^apps/platform/observability/.+/elasticsearch\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+version: (?<currentValue>[^\\s]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Limit npm maintenance to the development image tools",
      "matchManagers": ["npm"],
      "enabled": false
    },
    {
      "description": "Maintain Codex and its lockfile in the development image",
      "matchManagers": ["npm"],
      "matchFileNames": ["docker/homeops-dev/package.json"],
      "enabled": true,
      "rangeStrategy": "pin",
      "groupName": "homeops-dev npm tools"
    },
    {
      "description": "Keep container references reproducible",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Group GitHub Actions maintenance",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Require manual review for infrastructure major updates",
      "matchManagers": ["argocd", "kustomize", "terraform"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
