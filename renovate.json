{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(bump)"
  ],
  "timezone": "Europe/Paris",
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "enabledManagers": [
    "ansible-galaxy",
    "argocd",
    "custom.regex",
    "dockerfile",
    "github-actions",
    "kubernetes",
    "kustomize",
    "npm",
    "terraform",
    "mise",
    "pip-compile"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^apps/gitops/clusters/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/(argocd|bingops|cloudflare|platform|workloads)/.+\\.yaml$/",
      "/^capi/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update tool versions declared in Dockerfile environment variables",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[a-z-]+))?\\s+(?:ENV|ARG) [A-Z0-9_]+=(?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update Elastic Stack versions declared in ECK resources",
      "managerFilePatterns": [
        "/^apps/platform/observability/.+/elasticsearch\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+version: (?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Versioned native VM packages from signed APT repositories",
      "managerFilePatterns": [
        "/^environments/dev-vm/apt-tools\\.json$/"
      ],
      "matchStrings": [
        "\"name\": \"(?<depName>[^\"\\r\\n]+)\",\\s*\"version\": \"(?<currentValue>[^\"\\r\\n]+)\",\\s*\"registryUrl\": \"(?<registryUrl>[^\"\\r\\n]+)\""
      ],
      "datasourceTemplate": "deb"
    },
    {
      "customType": "regex",
      "description": "Native VM bootstrap tool releases",
      "managerFilePatterns": [
        "/^environments/dev-vm/versions\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+dev_mise_version: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^environments/dev-vm/oci-tools\\.json$/"
      ],
      "matchStrings": [
        "\"image\": \"mirror\\.gcr\\.io/(?<depName>[^\"\\s:]+):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "description": "Look up native OCI tool versions on Docker Hub while retaining the public pull mirror"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^environments/dev-vm/automation\\.json$/"
      ],
      "matchStrings": [
        "\"image\": \"(?<depName>ghcr\\.io/renovatebot/renovate):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Keep npm manifests under their owning release lock managers",
      "matchManagers": [
        "npm"
      ],
      "enabled": false
    },
    {
      "description": "Keep container references reproducible",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Group GitHub Actions maintenance",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Require manual review for infrastructure major updates",
      "matchManagers": [
        "argocd",
        "kustomize",
        "terraform"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "One reviewed PR per VM tool, including pinned versions",
      "matchFileNames": [
        "environments/dev-vm/**"
      ],
      "automerge": false,
      "groupName": null,
      "separateMajorMinor": true,
      "separateMinorPatch": true,
      "rangeStrategy": "pin",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Keep kubectl within the current labprod minor",
      "matchFileNames": [
        "environments/dev-vm/mise.toml"
      ],
      "matchPackageNames": [
        "kubectl"
      ],
      "allowedVersions": ">=1.36.0 <1.37.0"
    },
    {
      "description": "Keep Talos clients compatible with the current cluster minor",
      "matchFileNames": [
        "environments/dev-vm/mise.toml"
      ],
      "matchPackageNames": [
        "talosctl"
      ],
      "allowedVersions": ">=1.13.0 <1.14.0"
    },
    {
      "description": "Look up base and security updates for native Debian tools",
      "matchFileNames": [
        "environments/dev-vm/apt-tools.json"
      ],
      "matchDatasources": [
        "deb"
      ],
      "registryUrls": [
        "https://deb.debian.org/debian?suite=trixie&components=main&binaryArch=amd64",
        "https://deb.debian.org/debian?suite=trixie-updates&components=main&binaryArch=amd64",
        "https://security.debian.org/debian-security?suite=trixie-security&components=main&binaryArch=amd64"
      ]
    },
    {
      "matchFileNames": [
        "environments/dev-vm/apt-tools.json"
      ],
      "matchPackageNames": [
        "tailscale"
      ],
      "registryUrls": [
        "https://pkgs.tailscale.com/stable/debian?suite=trixie&components=main&binaryArch=amd64"
      ]
    },
    {
      "matchFileNames": [
        "environments/dev-vm/apt-tools.json"
      ],
      "matchPackageNames": [
        "postgresql-client-18"
      ],
      "registryUrls": [
        "https://apt.postgresql.org/pub/repos/apt?suite=trixie-pgdg&components=main&binaryArch=amd64"
      ]
    },
    {
      "description": "Debian repositories publish no release timestamps",
      "matchFileNames": [
        "environments/dev-vm/apt-tools.json"
      ],
      "matchDatasources": [
        "deb"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Keep the native Chromium browser and common files ABI-compatible",
      "matchDatasources": [
        "deb"
      ],
      "matchPackageNames": [
        "chromium",
        "chromium-common"
      ],
      "groupName": "Chromium native browser"
    },
    {
      "description": "Retain retired Coder sources without image or dependency updates",
      "matchFileNames": [
        "apps/workloads/coder/**",
        "docker/coder-bootstrap/**",
        "docker/coder-workspace/**",
        "docker/homeops-dev/**"
      ],
      "enabled": false
    }
  ],
  "mise": {
    "managerFilePatterns": [
      "/^environments/dev-vm/mise\\.toml$/"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^environments/dev-vm/requirements\\.txt$/"
    ]
  },
  "ansible-galaxy": {
    "managerFilePatterns": [
      "/(^|/)(requirements|collections)\\.ya?ml$/"
    ]
  }
}
