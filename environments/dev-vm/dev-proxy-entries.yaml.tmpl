# These entries are inserted into the existing shared-outpost blueprint.
- model: authentik_core.group
  id: dev-admins
  identifiers:
    name: dev-admins
  attrs:
    is_superuser: false
    users:
      - !Find [authentik_core.user, [username, bingops]]
- model: authentik_providers_proxy.proxyprovider
  id: dev-proxy-provider
  identifiers:
    name: Dev VM production
  attrs:
    mode: forward_domain
    external_host: https://dev.lab.bingo
    cookie_domain: dev.lab.bingo
    authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
    invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
- model: authentik_core.application
  id: dev-application
  identifiers:
    slug: dev
  attrs:
    name: Dev
    provider: !KeyOf dev-proxy-provider
    meta_launch_url: https://dev.lab.bingo
    policy_engine_mode: all
- model: authentik_policies.policybinding
  identifiers:
    target: !KeyOf dev-application
    group: !KeyOf dev-admins
    order: 0
  attrs:
    target: !KeyOf dev-application
    group: !KeyOf dev-admins
    order: 0
    enabled: true
    negate: false
    timeout: 30
