# Jetbrains
.idea

# Ansible
.ansible

# Terraform
terraform/**/.terraform/
terraform/**/terraform.tfstate*
# Private historical controller state, saved plans and logs remain local.
terraform/**/.runtime/
terraform/**/credentials.auto.tfvars
terraform/**/credentials*.tfvars
terraform/**/*.tfvars
!terraform/**/routes.auto.tfvars
/terraform.tfstate*

## Cloudflare credentials file
terraform/cloudflare/credentials

# Kubernetes
apps/**/charts
/kubeconfig
/apps/platform/authentik/credentials/

# Cluster API provider credentials
capi/credentials.env

# Generated Python cache; private account-link proofs must stay outside Git.
__pycache__/

# Coder template validation and local authentication
/apps/workloads/coder/base/template/.terraform/
/apps/workloads/coder/base/template/terraform.tfstate*
/apps/workloads/coder/credentials/

# Local Coder dashboard browser captures (fixture data only).
/hacks/tests/artifacts/

# Private operator recovery snapshots (retained-home backup scope).
/.runtime/

# Private VM migration inputs, release artifacts and recovery reports.
/.runtime/dev-vm/
/ansible/inventories/dev-vm.ini
/environments/dev-vm/*.env
/environments/dev-vm/*.ini
/environments/dev-vm/*password*

# Generated local access to the GitOps-owned gateway backend.
/terraform/edge-gateway/backend.tf.json
